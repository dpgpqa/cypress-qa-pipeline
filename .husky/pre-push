#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚀 Running pre-push checks..."

npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript typecheck failed. Fix type errors before pushing."
  exit 1
fi

npx cypress run --spec "cypress/e2e/smoke/**/*.cy.ts" --browser chrome
if [ $? -ne 0 ]; then
  echo "❌ Smoke tests failed. Fix failing tests before pushing."
  exit 1
fi

echo "✅ Pre-push checks passed."