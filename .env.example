# Base URL for the application under test
BASE_URL=https://www.saucedemo.com

# API base URL for API tests
API_BASE_URL=https://jsonplaceholder.typicode.com

# Test credentials for saucedemo.com
TEST_USER=standard_user
TEST_PASS=secret_sauce

# Disable video recording in CI
CYPRESS_DISABLE_VIDEO=true

# Update visual regression snapshots (set to true when intentionally updating baselines)
UPDATE_SNAPSHOTS=false

# Playwright Chromium channel (optional, for local debugging)
# PW_CHROMIUM_CHANNEL=chrome