{
  "name": "cypress-qa-pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "cypress run",
    "test:smoke": "cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts\" --browser chrome",
    "test:regression": "cypress run --spec \"cypress/e2e/regression/**/*.cy.ts\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:a11y": "cypress run --spec \"cypress/e2e/accessibility/**/*.cy.ts\"",
    "test:visual": "cypress run --spec \"cypress/e2e/visual/**/*.cy.ts\"",
    "test:coverage": "nyc npm test && npx report",
    "test:coverage:ci": "nyc npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js",
    "heal": "node scripts/cypress-healer.mjs",
    "heal:fix": "node scripts/cypress-healer.mjs --write",
    "report": "npx cypress run --reporter cypress-mochawesome-reporter"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cypress": "^16.2.0",
    "cypress-ctrf-json-reporter": "^0.2.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3"
  }
}
