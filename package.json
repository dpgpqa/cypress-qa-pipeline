{
  "name": "cypress-qa-pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "cypress run",
    "test:smoke": "bash test-server/run-tests.sh smoke",
    "test:regression": "bash test-server/run-tests.sh regression",
    "test:api": "bash test-server/run-tests.sh api",
    "test:a11y": "bash test-server/run-tests.sh a11y",
    "test:visual": "bash test-server/run-tests.sh visual",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js"
  },
  "devDependencies": {
    "@types/cypress": "^0.1.6",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cypress": "^13.0.0",
    "eslint": "^8.57.1",
    "express": "^5.3.0",
    "typescript": "^5.9.3"
  }
}
