{
  "name": "cypress-qa-pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node test-server/server.js",
    "test:smoke": "start-server-and-test start http://localhost:3000 -- 'cypress run --spec \"cypress/e2e/smoke/**/*.cy.ts\" --browser chrome'",
    "test:regression": "start-server-and-test start http://localhost:3000 -- 'cypress run --spec \"cypress/e2e/regression/**/*.cy.ts\"'",
    "test:api": "start-server-and-test start http://localhost:3000 -- 'cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"'",
    "test:a11y": "start-server-and-test start http://localhost:3000 -- 'cypress run --spec \"cypress/e2e/accessibility/**/*.cy.ts\"'",
    "test:visual": "start-server-and-test start http://localhost:3000 -- 'cypress run --spec \"cypress/e2e/visual/**/*.cy.ts\"'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js"
  },
  "devDependencies": {
    "@types/cypress": "^0.1.6",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "cypress": "^13.0.0",
    "eslint": "^8.57.1",
    "express": "^5.3.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "^5.9.3"
  }
}
